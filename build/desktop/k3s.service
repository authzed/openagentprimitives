# k3s.service — vendored copy of the systemd unit the official k3s install
# script (get.k3s.io) writes, so `mage desktop:rootfs` (magefiles/desktop.go)
# can bake a hermetic offline rootfs without ever running that installer (which
# reaches out to github.com/rancher/k3s-selinux, does a systemd daemon-reload
# against the LIVE system, and generally assumes it's setting up a real
# server — none of which applies to a virt-customize offline image build).
#
# Kept byte-for-byte close to upstream so a future k3s version bump (see
# magefiles/desktop.go's k3sVersion const) doesn't also require reverse-
# engineering unit changes.
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
EnvironmentFile=-/etc/sysconfig/k3s
EnvironmentFile=-/etc/systemd/system/k3s.service.env
KillMode=process
Delegate=yes
# Having non-zero Limit*s causes performance problems due to accounting
# overhead in the kernel. We recommend using cgroups to do container-local
# accounting.
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server
