{
  "name": "goals-discovery-webhook-owner-refused",
  "description": "A real signed webhook with a configured session owner cannot enable private discovery without primary-human evidence. Literal model-supplied discovery scope and retries fail before any proposal, question or watch authority exists.",
  "agentDir": "testdata/goals-discovery-webhook-owner-refused",
  "agentClass": "eventgoal",
  "llm": [
    {
