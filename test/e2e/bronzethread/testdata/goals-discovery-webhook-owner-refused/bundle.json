              "terms": {
                "dueAt": "2030-01-01T12:00:00Z",
                "expiresAt": "2030-01-08T12:10:00Z",
                "bounds": {
                  "durationSeconds": 180,
                  "turns": 10,
                  "tokens": 10000,
                  "approvalSeconds": 90
                },
                "allowedOperations": [
