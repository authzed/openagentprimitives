{
  "name": "slot-approval-denial-then-approval",
  "description": "The reverse order of slot-approval-binds-one-company: user A is refused Fabrikam FIRST and only then approved for Northwind. Same two outcomes, opposite sequence — which is what distinguishes a real per-instance decision from an artifact of ordering, such as a first approval that quietly widens the session, or a first denial that poisons every later call through the same tool.\n\nAssertions read as in that bundle: `denied` is recorded for both (the approved re-dispatch is not re-Checked into the log), and the tool results are what separate them — Fabrikam an error with no contact rows, Northwind the contacts with isError false.",

  "agentDir": "../testdata/agent-centerdot-companies",
  "agentClass": "centerdot-companies",

  "defaultUser": "user@example.com",
  "autoApprove": ["tool_approval"],
  "autoApproveAs": "owner-1@example.com",

  "toolOutputs": {
    "list_companies": {
      "results": [
        { "id": "4210", "name": "Northwind Trading", "ownerId": "owner-1", "createdAt": "2026-07-02T09:14:00Z" },
        { "id": "4299", "name": "Fabrikam Logistics", "ownerId": "owner-9", "createdAt": "2026-07-05T11:02:00Z" }
      ]
    },
    "list_contacts_for_company": {
      "results": [
        { "id": "c-88", "firstName": "Jane", "lastName": "Smith", "email": "jane.smith@northwind.example", "title": "Ops Lead" }
      ]
    }
  },

  "userTurns": [
    "list the companies",
    "who works at Fabrikam Logistics, and who works at Northwind Trading?"
  ],

  "llm": [
    {
      "expect": { "userTextContains": "list the companies" },
      "reply": [{ "toolUse": { "name": "centerdot_list_companies", "args": { "operation_id": "op-list", "_reason": "user asked for the company list", "args": { "sinceDays": 30 } } } }]
    },
    {
      "expect": {
        "lastToolResult": "centerdot_list_companies",
        "lastToolResultContains": "Fabrikam Logistics",
        "lastToolResultIsError": false
      },
      "reply": [{ "text": "Northwind Trading and Fabrikam Logistics" }]
    },
    {
      "expect": { "lastToolResult": "respond_to_user" },
      "reply": [{ "toolUse": { "name": "agent_work_complete", "args": { "summary": "listed" } } }]
    },

    {
      "expect": { "userTextContains": "who works at Fabrikam Logistics" },
      "reply": [{ "toolUse": { "name": "centerdot_list_contacts_for_company", "args": { "operation_id": "op-contacts-4299", "_reason": "user asked who works at that company", "args": { "companyId": "4299" } } } }]
    },
    {
      "expect": {
        "lastToolResult": "centerdot_list_contacts_for_company",
        "lastToolResultNotContains": "jane.smith@northwind.example",
        "lastToolResultIsError": true
      },
      "reply": [{ "toolUse": { "name": "centerdot_list_contacts_for_company", "args": { "operation_id": "op-contacts-4210", "_reason": "user asked who works at that company", "args": { "companyId": "4210" } } } }]
    },
    {
      "expect": {
        "lastToolResult": "centerdot_list_contacts_for_company",
        "lastToolResultContains": "jane.smith@northwind.example",
        "lastToolResultIsError": false
      },
      "reply": [{ "text": "I could not read the contacts for Fabrikam Logistics; Jane Smith works at Northwind Trading" }]
    },
    {
      "expect": { "lastToolResult": "respond_to_user" },
      "reply": [{ "toolUse": { "name": "agent_work_complete", "args": { "summary": "done" } } }]
    }
  ],

  "assert": {
    "agentReplyContains": [
      "Northwind Trading",
      "Jane Smith works at Northwind Trading"
    ],
    "authz": {
      "decisions": {
        "crm_company:4299#contact_access": "denied",
        "crm_company:4210#contact_access": "denied"
      },
      "neverAllowed": ["crm_company:4299#contact_access"]
    }
  }
}
