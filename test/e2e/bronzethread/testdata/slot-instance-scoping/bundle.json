{
  "name": "slot-instance-scoping",
  "description": "A slot is per INSTANCE, not per type. The session runs as owner-1@example.com, who owns company 4210 and not 4299; the same tool with the same permission resolves allowed for the owned one and denied for the other. It also covers the `owner` leg of the composed permission (slot_grant_<perm>->interact + owner) — the arm that lets a requester with existing standing through with no grant and no approval, which is what keeps approval volume proportional to what the AGENT adds rather than to what the human could already do. Two turns, because the owner_ref tuple the second turn chains through is JIT-written from the first turn's response.",

  "agentDir": "../testdata/agent-centerdot-companies",
  "agentClass": "centerdot-companies",

  "defaultUser": "owner-1@example.com",

  "toolOutputs": {
    "list_companies": {
      "results": [
        { "id": "4210", "name": "Northwind Trading", "ownerId": "owner-1", "createdAt": "2026-07-02T09:14:00Z" },
        { "id": "4299", "name": "Fabrikam Logistics", "ownerId": "owner-9", "createdAt": "2026-07-05T11:02:00Z" }
      ]
    },
    "list_contacts_for_company": {
      "results": [
        { "id": "c-88", "firstName": "Jane", "lastName": "Smith", "email": "jane.smith@northwind.example", "title": "Ops Lead" }
      ]
    }
  },

  "userTurns": [
    "list the companies",
    "show me the contacts for Northwind and for Fabrikam"
  ],

  "llm": [
    {
      "expect": { "userTextContains": "list the companies" },
      "reply": [{ "toolUse": { "name": "centerdot_list_companies", "args": { "operation_id": "op-list", "_reason": "user asked for the company list", "args": { "sinceDays": 30 } } } }]
    },
    {
      "expect": { "lastToolResult": "centerdot_list_companies" },
      "reply": [{ "text": "Northwind Trading and Fabrikam Logistics" }]
    },
    {
      "expect": { "lastToolResult": "respond_to_user" },
      "reply": [{ "toolUse": { "name": "agent_work_complete", "args": { "summary": "listed" } } }]
    },

    {
      "expect": { "userTextContains": "show me the contacts" },
      "reply": [{ "toolUse": { "name": "centerdot_list_contacts_for_company", "args": { "operation_id": "op-contacts-4210", "_reason": "user asked who works at that company", "args": { "companyId": "4210" } } } }]
    },
    {
      "expect": { "lastToolResult": "centerdot_list_contacts_for_company" },
      "reply": [{ "toolUse": { "name": "centerdot_list_contacts_for_company", "args": { "operation_id": "op-contacts-4299", "_reason": "user asked who works at that company", "args": { "companyId": "4299" } } } }]
    },
    {
      "expect": { "lastToolResult": "centerdot_list_contacts_for_company" },
      "reply": [{ "text": "Jane Smith works at Northwind Trading; Fabrikam Logistics was not readable" }]
    },
    {
      "expect": { "lastToolResult": "respond_to_user" },
      "reply": [{ "toolUse": { "name": "agent_work_complete", "args": { "summary": "done" } } }]
    }
  ],

  "assert": {
    "agentReplyContains": [
      "Northwind Trading",
      "Jane Smith"
    ],
    "authz": {
      "decisions": {
        "crm_company:4210#contact_access": "allowed",
        "crm_company:4299#contact_access": "denied"
      },
      "neverAllowed": ["crm_company:4299#contact_access"]
    }
  }
}
